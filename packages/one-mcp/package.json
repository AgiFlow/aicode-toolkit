{
  "name": "@agiflowai/one-mcp",
  "version": "0.5.0",
  "description": "One MCP server package",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typescript"
  ],
  "license": "AGPL-3.0",
  "bin": {
    "one-mcp": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "node --loader ts-node/esm src/cli.ts mcp-serve",
    "build": "tsdown",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agiflowai/aicode-utils": "workspace:*",
    "@modelcontextprotocol/client": "2.1.0",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@modelcontextprotocol/server-legacy": "2.1.0",
    "chalk": "6.0.0",
    "commander": "15.0.0",
    "express": "5.2.1",
    "js-yaml": "5.4.2",
    "liquidjs": "10.29.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "unplugin-raw": "0.8.0",
    "vitest": "5.0.2"
  }
}
