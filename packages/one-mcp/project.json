{
  "name": "@agiflowai/one-mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/one-mcp",
  "projectType": "application",
  "sourceTemplate": "typescript-mcp-package",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint packages/one-mcp && oxfmt --check packages/one-mcp"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint --fix packages/one-mcp && oxfmt packages/one-mcp"
      }
    }
  }
}
