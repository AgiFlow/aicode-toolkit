{
  "name": "@agiflowai/aicode-utils",
  "version": "1.3.0",
  "description": "Shared utilities and types for AI-powered code generation, scaffolding, and analysis",
  "keywords": [
    "boilerplate",
    "code-generation",
    "generator",
    "library",
    "scaffold",
    "template",
    "typescript"
  ],
  "homepage": "https://github.com/AgiFlow/aicode-toolkit#readme",
  "bugs": {
    "url": "https://github.com/AgiFlow/aicode-toolkit/issues"
  },
  "license": "AGPL-3.0",
  "author": "AgiflowIO",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgiFlow/aicode-toolkit.git",
    "directory": "packages/aicode-utils"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "6.0.0",
    "execa": "9.6.1",
    "js-yaml": "4.3.2",
    "ora": "9.4.1",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.6.3",
    "@types/ora": "3.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "chance": "1.1.13",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
