{
  "name": "@agiflowai/style-system",
  "version": "0.1.2",
  "description": "MCP server for exploring themes, Tailwind CSS classes, and UI components from Storybook with standalone component rendering capabilities",
  "keywords": [
    "design-system",
    "mcp",
    "model-context-protocol",
    "storybook",
    "tailwind",
    "typescript"
  ],
  "license": "AGPL-3.0",
  "bin": {
    "style-system": "./dist/cli.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "node --loader ts-node/esm src/cli.ts mcp-serve",
    "build": "tsdown",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agiflowai/aicode-utils": "workspace:*",
    "@modelcontextprotocol/server": "2.1.0",
    "@tailwindcss/vite": "4.3.3",
    "chalk": "6.0.0",
    "commander": "15.0.0",
    "glob": "13.0.6",
    "js-yaml": "5.4.2",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@babel/traverse": "8.0.6",
    "@babel/types": "8.0.6",
    "@types/babel__traverse": "7.28.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
