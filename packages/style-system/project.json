{
  "name": "@agiflowai/style-system",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/mcp/style-system",
  "projectType": "application",
  "sourceTemplate": "typescript-mcp-package",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint packages/style-system && oxfmt --check packages/style-system"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint --fix packages/style-system && oxfmt packages/style-system"
      }
    }
  }
}
