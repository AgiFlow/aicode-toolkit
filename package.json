{
  "name": "@scaffold-mcp/source",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint:fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "plugins:generate": "node scripts/generate-plugins.mjs",
    "plugins:check": "node scripts/generate-plugins.mjs --check && node scripts/validate-plugins.mjs",
    "plugins:test": "node --test scripts/tests/plugins.test.mjs",
    "plugins:pack": "node scripts/package-plugins.mjs",
    "commit": "commit",
    "release": "nx release",
    "release:dry-run": "nx release --dry-run",
    "prepare": "husky"
  },
  "dependencies": {
    "@nx/js": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/workspace": "23.2.1",
    "nx": "23.2.1",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-nx-scopes": "21.2.3",
    "@commitlint/prompt-cli": "21.2.3",
    "husky": "9.1.7",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "syncpack": "15.3.3"
  }
}
