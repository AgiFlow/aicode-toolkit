{
  "mcpServers": {
    "aicode-scaffold-admin": {
      "command": "npx",
      "args": [
        "-y",
        "@agiflowai/scaffold-mcp@2.0.0",
        "mcp-serve",
        "--type",
        "stdio",
        "--admin-enable"
      ]
    },
    "aicode-architect-admin": {
      "command": "npx",
      "args": [
        "-y",
        "@agiflowai/architect-mcp@2.0.0",
        "mcp-serve",
        "--type",
        "stdio",
        "--admin-enable"
      ]
    }
  }
}
